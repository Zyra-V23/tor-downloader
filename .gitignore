# Onion Downloader - Git Ignore

# Download directory and content
downloaded_site/
downloads/

# Configuration files (may contain sensitive URLs)
download_config.conf
config.conf

# Log files
*.log
download.log
error.log

# Temporary files
*.tmp
*.temp
/tmp/
.tmp/

# Downloaded content
*.onion/
downloaded_*/

# Reports
download_report_*.txt
*_report_*.txt

# Semaphore files
/tmp/onion_download_semaphore_*

# System files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-*

# Backup files
*.bak
*.backup
*.orig

# OS generated files
.directory
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Test files
test_*
debug_*

# Personal notes
notes.txt
notes.md
personal_*

# Windows specific
desktop.ini
*.lnk 